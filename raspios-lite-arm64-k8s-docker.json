{
	"builders": [
		{
			"type": "arm",
			"file_urls": [
				"https://downloads.raspberrypi.org/raspios_lite_arm64/images/raspios_lite_arm64-2024-10-28/2024-10-22-raspios-bookworm-arm64-lite.img.xz"
			],
			"file_checksum_url": "https://downloads.raspberrypi.org/raspios_lite_arm64/images/raspios_lite_arm64-2024-10-28/2024-10-22-raspios-bookworm-arm64-lite.img.xz.sha256",
			"file_checksum_type": "sha256",
			"file_target_extension": "xz",
			"file_unarchive_cmd": [
				"xz",
				"--decompress",
				"$ARCHIVE_PATH"
			],
			"image_build_method": "resize",
			"image_path": "raspios-lite-bookworm-arm64-k8s.img",
			"image_size": "8G",
			"image_type": "dos",
			"image_partitions": [
				{
					"name": "boot",
					"type": "c",
					"start_sector": "8192",
					"filesystem": "vfat",
					"size": "256M",
					"mountpoint": "/boot"
				},
				{
					"name": "root",
					"type": "83",
					"start_sector": "532480",
					"filesystem": "ext4",
					"size": "0",
					"mountpoint": "/"
				}
			],
			"image_chroot_env": [
				"PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
			],
			"qemu_binary_source_path": "/usr/bin/qemu-arm-static",
			"qemu_binary_destination_path": "/usr/bin/qemu-arm-static"
		}
	],
	"provisioners": [
		{
			"type": "shell",
			"inline": "echo '// Docker, socat, dnsmasq'"
		},
		{
			"inline": [
				"sudo apt update",
				"sudo apt install -y docker.io socat dnsmasq cockpit vim",
				"sudo apt auto-remove -y"
			],
			"type": "shell"
		},
		{
			"inline": [
				"sed -i '/\\[plugins.\"io.containerd.grpc.v1.cri\"\\]/a \\ \\ \\ \\ sandbox_image = \"registry.k8s.io/pause:3.9\"' /etc/containerd/config.toml",
				"echo '  [plugins.\"io.containerd.grpc.v1.cri\".containerd.runtimes.runc]' \u003e\u003e /etc/containerd/config.toml",
				"echo '    runtime_type = \"io.containerd.runc.v2\"' \u003e\u003e /etc/containerd/config.toml",
				"echo '    [plugins.\"io.containerd.grpc.v1.cri\".containerd.runtimes.runc.options]' \u003e\u003e /etc/containerd/config.toml",
				"echo '      SystemdCgroup = true' \u003e\u003e /etc/containerd/config.toml"
				  
			],
			"type": "shell"
		},
		{
			"inline": [
				"curl -L --fail --remote-name-all https://github.com/RamonGiovane/guiptables/archive/refs/tags/1.4.0.tar.gz",
				"sudo tar xzvfC 1.4.0.tar.gz /usr/share/cockpit/",
				"rm 1.4.0.tar.gz",
				"sudo mkdir /etc/systemd/system/cockpit.socket.d/"
			],
			"type": "shell"
		},
		{
			"type": "file",
			"source": "sources//etc/systemd/system/cockpit.socket.d/override.conf",
			"destination": "/etc/systemd/system/cockpit.socket.d/override.conf"
		},
		{
			"type": "file",
			"source": "sources//etc/dnsmasq.d/usb0",
			"destination": "/etc/dnsmasq.d/usb0"
		},
		{
			"type": "file",
			"source": "sources//etc/network/interfaces.d/usb0",
			"destination": "/etc/network/interfaces.d/usb0"
		},
		{
			"inline": [
				"echo dtoverlay=dwc2,dr_mode=peripheral \u003e\u003e /boot/config.txt",
				"sed -i 's/#dtparam=i2c_arm/dtparam=i2c_arm/' /boot/config.txt",
				"sed -i 's/#dtparam=spi/dtparam=spi/' /boot/config.txt",
				"sed -i 's/$/ modules-load=dwc2,g_ether/' /boot/cmdline.txt",
				"sed -i '$ s/$/ cgroup_enable=cpuset cgroup_enable=memory cgroup_memory=1 swapaccount=1/' /boot/cmdline.txt",
				"sed -i 's/#net.ipv4.ip_forward=1/net.ipv4.ip_forward=1/' /etc/sysctl.conf",
				"touch /boot/ssh",
				"echo denyinterfaces usb0 \u003e\u003e /etc/dhcpcd.conf"
			],
			"type": "shell"
		},
		{
			"type": "shell",
			"inline": "echo '// Alias k=kubectl & Kubeconfig'"
		},
		{
			"type": "shell",
			"inline": [
				"echo alias k=kubectl \u003e\u003e /home/pi/.bash_aliases",
				"echo export KUBECONFIG=/etc/kubernetes/admin.conf \u003e\u003e /home/pi/.bashrc",
				"sudo echo alias k=kubectl \u003e\u003e /root/.bashrc",
				"sudo echo export KUBECONFIG=/etc/kubernetes/admin.conf \u003e\u003e /root/.bashrc"
			]
		},
		{
			"type": "shell",
			"inline": "echo '// CRI dockerd'"
		},
		{
			"inline": [
				"wget https://github.com/Mirantis/cri-dockerd/releases/download/v0.3.15/cri-dockerd-0.3.15.arm64.tgz",
				"tar -xvzf cri-dockerd-0.3.15.arm64.tgz",
				"sudo mv cri-dockerd/cri-dockerd /usr/bin/cri-dockerd",
				"sudo chmod +x /usr/bin/cri-dockerd",
				"wget https://raw.githubusercontent.com/Mirantis/cri-dockerd/master/packaging/systemd/cri-docker.service",
				"wget https://raw.githubusercontent.com/Mirantis/cri-dockerd/master/packaging/systemd/cri-docker.socket",
				"sudo mv cri-docker.service /etc/systemd/system/",
				"sudo mv cri-docker.socket /etc/systemd/system/",
				"sudo systemctl enable cri-docker.service",
				"sudo systemctl enable cri-docker.socket",
				"sudo systemctl start cri-docker.service",
				"sudo systemctl start cri-docker.socket",
				"rm cri-dockerd-0.3.15.arm64.tgz"
			],
			"type": "shell"
		},
		{
			"type": "shell",
			"inline": "echo '// K8s binaries'"
		},
		{
			"inline": [
				"sudo apt-get install -y apt-transport-https ca-certificates curl gpg",
				"curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.30/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg",
				"sudo echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.30/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list",
				"sudo apt-get update",
				"sudo apt-get install -y kubelet kubeadm kubectl",
				"sudo apt-mark hold kubelet kubeadm kubectl",
				"sudo service dphys-swapfile stop",
				"sudo systemctl disable dphys-swapfile"
			],
			"type": "shell"
		},
		{
			"type": "shell",
			"inline": "echo '// Helm'"
		},
		{
			"inline": [
				"curl https://baltocdn.com/helm/signing.asc | gpg --dearmor | sudo tee /usr/share/keyrings/helm.gpg > /dev/null",
				"sudo apt-get install apt-transport-https --yes",
				"echo 'deb [arch=arm64 signed-by=/usr/share/keyrings/helm.gpg] https://baltocdn.com/helm/stable/debian/ all main' | sudo tee /etc/apt/sources.list.d/helm-stable-debian.list",
				"sudo apt-get update",
				"sudo apt-get install helm"
			],
			"type": "shell"
		},
		{
			"type": "shell",
			"inline": "echo '// CILIUM CLI'"
		},
		{
			"inline": [
				"export CILIUM_CLI_VERSION=v0.16.20",
				"export CILIUM_CLI_ARCH=arm64",
				"curl -L --fail --remote-name-all https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${CILIUM_CLI_ARCH}.tar.gz",
				"curl -L --fail --remote-name-all https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${CILIUM_CLI_ARCH}.tar.gz.sha256sum",
				"sha256sum --check cilium-linux-${CILIUM_CLI_ARCH}.tar.gz.sha256sum",
				"sudo tar xzvfC cilium-linux-${CILIUM_CLI_ARCH}.tar.gz /usr/local/bin",
				"rm cilium-linux-${CILIUM_CLI_ARCH}.tar.gz",
				"rm cilium-linux-${CILIUM_CLI_ARCH}.tar.gz.sha256sum"
			],
			"type": "shell"
		},
		{
			"type": "file",
			"source": "cilium-values.yaml",
			"destination": "/home/pi/cilium-values.yaml"
		},
		{
			"type": "shell",
			"inline": "echo ::BUILD::SUCCESS"
		}
	]
}